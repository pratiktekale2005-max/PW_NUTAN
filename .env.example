# ====================================================================
# AegisPulse AI: Hackathon Master Environment Configuration
# Project: pw-nutan | Region: asia-south1 (Mumbai)
# ====================================================================

# Backend Server Port
PORT=5000

# --------------------------------------------------------------------
# 1. Google Gemini AI (Server-Side Only - NEVER expose to client)
# --------------------------------------------------------------------
# Create in Google AI Studio: https://aistudio.google.com/
# Leave as placeholder for zero-config high-fidelity resilient simulation mode
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_FLASH=gemini-1.5-flash
GEMINI_MODEL_PRO=gemini-1.5-pro

# --------------------------------------------------------------------
# 2. Firebase & Cloud Firestore (Project: pw-nutan)
# --------------------------------------------------------------------
FIREBASE_PROJECT_ID=pw-nutan
FIREBASE_REGION=asia-south1
# Optional: Path to downloaded Firebase Service Account JSON (ignored in git)
# If omitted, server runs with active persistent Firestore emulation
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json

# --------------------------------------------------------------------
# 3. Client Firebase Web App Configuration (Safe for client bundle)
# --------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=pw-nutan.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=pw-nutan
VITE_FIREBASE_STORAGE_BUCKET=pw-nutan.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here

# --------------------------------------------------------------------
# 4. Google Maps & Security Secrets
# --------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
BIGQUERY_DATASET=aegispulse_telemetry_dw
JWT_SECRET=aegispulse-super-secure-production-secret-key-2026
AUDIT_SIGNING_KEY=aegispulse-audit-merkle-signing-key-2026
RATE_LIMIT_MAX=60
NODE_ENV=development
